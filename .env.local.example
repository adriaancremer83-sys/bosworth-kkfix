# Scan logging writes to the Kia-Kaha Mining Supabase project (table: qr_scans).
# Get these from the Kia-Kaha Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<kiakaha-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<kiakaha-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<kiakaha-service-role-key>

# Public base URL of this portal (used for absolute links / QR targets).
NEXT_PUBLIC_BASE_URL=https://bosworth-kkfix.vercel.app

# Gates /stats (the scan dashboard). Choose a strong value.
ADMIN_PASSWORD=choose-a-strong-password-here
